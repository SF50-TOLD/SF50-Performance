{
  "sourceLanguage": "en",
  "strings": {
    "AC 91-79B landing distance factors are applied. The configured safety factor is not applied to RwyCC landing distances.": {
      "comment": "A performance note.",
      "extractionState": "manual"
    },
    "Air Conditioner On": {
      "comment": "A distance adjustment for running the air conditioner during takeoff.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Conditioner On"
          }
        }
      }
    },
    "Airport elevation of %@ is above the manual’s %@ limit.": {
      "comment": "A performance note. The arguments are the elevation and the highest approved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Airport elevation of %1$@ is above the manual’s %2$@ limit."
          }
        }
      }
    },
    "Airport elevation of %@ is below the manual’s %@ limit.": {
      "comment": "A performance note. The arguments are the elevation and the lowest approved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Airport elevation of %1$@ is below the manual’s %2$@ limit."
          }
        }
      }
    },
    "Airport elevation of %@ is outside the AFM’s %@ to %@ limits.": {
      "comment": "A performance note. The arguments are the elevation and the approved range.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Airport elevation of %1$@ is outside the AFM’s %2$@ to %3$@ limits."
          }
        }
      }
    },
    "An obstacle %@ tall stands within the takeoff distance, where the aircraft is still below the 50-foot screen height.": {
      "comment": "A performance note. The argument is the obstacle’s height above the runway.",
      "extractionState": "manual"
    },
    "Apple Weather": {
      "comment": "The name of Apple’s weather service.",
      "extractionState": "manual"
    },
    "Contaminated runway performance data is considered supplemental and is not FAA approved.": {
      "comment": "A performance note.",
      "extractionState": "manual"
    },
    "Contamination": {
      "comment": "A distance adjustment for a contaminated runway.",
      "extractionState": "manual"
    },
    "Crosswind of %@ exceeds the %@ demonstrated crosswind.": {
      "comment": "A performance note. The arguments are the crosswind and the AFM's maximum demonstrated crosswind.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crosswind of %1$@ exceeds the %2$@ demonstrated crosswind."
          }
        }
      }
    },
    "Data table couldn’t be loaded.": {
      "comment": "Error description for a performance data table that could not be read.",
      "extractionState": "manual"
    },
    "Downhill — %@": {
      "comment": "A distance adjustment. The argument is the runway slope, as a percentage.",
      "extractionState": "manual"
    },
    "Equation type mismatch: expected %@, got %@.": {
      "comment": "Failure reason for a regression equation. The arguments are equation types.",
